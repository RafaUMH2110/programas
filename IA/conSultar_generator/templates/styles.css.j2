{# =====================================================================
   TOKENS DE DISEÑO (inyectados desde config.tema — ver validators.py para
   las reglas de formato exigidas a cada valor antes de llegar aquí).
   ===================================================================== #}
:root {
  --color-bg: {{ config.tema.color_fondo }};
  --color-surface: #FFFFFF;
  --color-surface-alt: {{ config.tema.color_secundario }};
  --color-border: {{ config.tema.color_borde }};
  --color-border-strong: {{ config.tema.color_borde }};

  --color-primary: {{ config.tema.color_primario }};
  --color-primary-hover: {{ config.tema.color_primario_hover }};
  --color-primary-soft: {{ config.tema.color_acento }};
  --color-primary-contrast: #FFFFFF;

  --color-text: {{ config.tema.color_texto }};
  --color-text-muted: {{ config.tema.color_texto_tenue }};
  --color-text-faint: {{ config.tema.color_texto_tenue }};

  --color-success-bg: #E7F5EC;
  --color-success-text: #206A44;
  --color-error-bg: #FCEAEA;
  --color-error-text: #9A2C24;
  --color-warning-bg: #FEF6E4;
  --color-warning-text: #7A5B12;

  --font-sans: {{ config.tema.familia_tipografica }};
  --font-mono: {{ config.tema.familia_monoespaciada }};

  --radius-lg: {{ config.tema.radio_borde }};
  --radius-md: calc({{ config.tema.radio_borde }} * 0.7);
  --radius-sm: calc({{ config.tema.radio_borde }} * 0.4);

  --shadow-card: {{ config.tema.sombra }};
  --max-width: {{ config.tema.ancho_maximo }};
}

* { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body {
  margin: 0;
  background: var(--color-bg);
  color: var(--color-text);
  font-family: var(--font-sans);
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
}

.skip-link {
  position: absolute;
  left: -999px;
  top: auto;
  background: var(--color-primary);
  color: #fff;
  padding: 10px 16px;
  border-radius: var(--radius-sm);
  z-index: 1000;
}
.skip-link:focus { left: 16px; top: 16px; }

a:focus-visible,
button:focus-visible,
input:focus-visible,
select:focus-visible,
textarea:focus-visible {
  outline: 3px solid var(--color-primary-soft);
  outline-offset: 2px;
}

.app-shell {
  max-width: var(--max-width);
  margin: 0 auto;
  padding: 0 20px 64px;
}

header.app-header {
  background: linear-gradient(180deg, var(--color-surface-alt) 0%, var(--color-bg) 100%);
  border-bottom: 1px solid var(--color-border);
  padding: 40px 20px 32px;
  margin-bottom: 32px;
}

.app-header-inner {
  max-width: var(--max-width);
  margin: 0 auto;
  display: flex;
  align-items: center;
  gap: 16px;
}

.app-logo { flex: 0 0 auto; width: 48px; height: 48px; }

.app-header-text h1 {
  margin: 0;
  font-size: 1.7rem;
  font-weight: 700;
  color: var(--color-text);
  letter-spacing: -0.01em;
}

.app-header-text p {
  margin: 4px 0 0;
  color: var(--color-text-muted);
  font-size: 0.98rem;
  max-width: 52ch;
}

section.card {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  padding: 24px;
  margin-bottom: 24px;
}

section.card > h2 { margin: 0 0 4px; font-size: 1.15rem; font-weight: 600; }
section.card > p.card-subtitle { margin: 0 0 20px; color: var(--color-text-muted); font-size: 0.92rem; }

.field { margin-bottom: 18px; }
.field:last-child { margin-bottom: 0; }

.field > label, .field > legend {
  display: block;
  font-weight: 600;
  font-size: 0.93rem;
  margin-bottom: 6px;
  color: var(--color-text);
}

.field .hint { display: block; font-size: 0.82rem; color: var(--color-text-muted); margin-top: 6px; }

input[type="text"],
input[type="password"],
input[type="number"],
select,
textarea {
  width: 100%;
  font-family: inherit;
  font-size: 0.97rem;
  color: var(--color-text);
  background: var(--color-surface);
  border: 1px solid var(--color-border-strong);
  border-radius: var(--radius-md);
  padding: 10px 12px;
  transition: border-color 0.15s ease, box-shadow 0.15s ease;
}

input:hover, select:hover, textarea:hover { border-color: var(--color-primary); }
input:focus, select:focus, textarea:focus {
  border-color: var(--color-primary);
  box-shadow: 0 0 0 3px var(--color-primary-soft);
}

textarea { resize: vertical; min-height: 96px; line-height: 1.5; }
textarea#consulta-input { min-height: 140px; }

.field-invalid { border-color: var(--color-error-text) !important; }
.error-text { display: block; color: var(--color-error-text); font-size: 0.85rem; margin-top: 6px; }

.field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
@media (max-width: 560px) { .field-row { grid-template-columns: 1fr; } }

.checkbox-field { display: flex; align-items: flex-start; gap: 10px; }
.checkbox-field input[type="checkbox"] {
  width: 20px; height: 20px; margin-top: 2px;
  accent-color: var(--color-primary); flex: 0 0 auto;
}
.checkbox-field label { font-weight: 600; font-size: 0.95rem; cursor: pointer; }

.export-subfields {
  margin-top: 16px; padding: 16px;
  background: var(--color-surface-alt);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
}
.export-subfields[hidden] { display: none; }

.api-key-field { position: relative; }
.api-key-field input { padding-right: 84px; }
.toggle-visibility-btn {
  position: absolute; right: 6px; top: 50%; transform: translateY(-50%);
  background: transparent; border: none; color: var(--color-primary);
  font-size: 0.82rem; font-weight: 600; padding: 6px 8px; cursor: pointer;
  border-radius: var(--radius-sm);
}
.toggle-visibility-btn:hover { background: var(--color-primary-soft); }

.notice {
  display: flex; gap: 10px; align-items: flex-start;
  background: var(--color-warning-bg); color: var(--color-warning-text);
  border: 1px solid #F0DDAE; border-radius: var(--radius-md);
  padding: 12px 14px; font-size: 0.85rem; margin-top: 10px;
}
.notice svg { flex: 0 0 auto; margin-top: 1px; }

.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  font-family: inherit; font-size: 0.97rem; font-weight: 600;
  padding: 12px 22px; border-radius: var(--radius-md); border: 1px solid transparent;
  cursor: pointer; transition: background-color 0.15s ease, border-color 0.15s ease, opacity 0.15s ease;
}
.btn-primary { background: var(--color-primary); color: var(--color-primary-contrast); }
.btn-primary:hover:not(:disabled) { background: var(--color-primary-hover); }
.btn-primary:disabled { background: #B7CBDA; cursor: not-allowed; }

.btn-secondary { background: var(--color-surface); color: var(--color-primary); border-color: var(--color-primary); }
.btn-secondary:hover:not(:disabled) { background: var(--color-primary-soft); }
.btn-secondary:disabled { color: var(--color-text-faint); border-color: var(--color-border-strong); cursor: not-allowed; }

.btn-row { display: flex; justify-content: flex-end; margin-top: 20px; }

.spinner {
  width: 16px; height: 16px; border-radius: 50%;
  border: 2.5px solid rgba(255, 255, 255, 0.4); border-top-color: #fff;
  animation: spin 0.7s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
@media (prefers-reduced-motion: reduce) { .spinner { animation: none; } }

#status-area { margin-top: 16px; min-height: 0; }
.status-message { display: flex; gap: 10px; align-items: flex-start; padding: 12px 14px; border-radius: var(--radius-md); font-size: 0.9rem; line-height: 1.4; }
.status-message svg { flex: 0 0 auto; margin-top: 2px; }
.status-info { background: var(--color-primary-soft); color: var(--color-primary-hover); }
.status-error { background: var(--color-error-bg); color: var(--color-error-text); }
.status-success { background: var(--color-success-bg); color: var(--color-success-text); }

#resultado-placeholder { color: var(--color-text-faint); font-size: 0.95rem; padding: 12px 0; }
#resultado-contenido { font-size: 0.98rem; color: var(--color-text); overflow-wrap: anywhere; }
#resultado-contenido[hidden] { display: none; }

#resultado-contenido h1, #resultado-contenido h2, #resultado-contenido h3, #resultado-contenido h4 { line-height: 1.3; margin: 1.3em 0 0.5em; }
#resultado-contenido h1:first-child, #resultado-contenido h2:first-child, #resultado-contenido h3:first-child { margin-top: 0; }
#resultado-contenido p { margin: 0 0 1em; }
#resultado-contenido ul, #resultado-contenido ol { margin: 0 0 1em; padding-left: 1.4em; }
#resultado-contenido li { margin-bottom: 0.35em; }
#resultado-contenido a { color: var(--color-primary); }

#resultado-contenido blockquote {
  margin: 0 0 1em; padding: 4px 16px; border-left: 3px solid var(--color-primary);
  background: var(--color-surface-alt); color: var(--color-text-muted);
  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
}
#resultado-contenido code { font-family: var(--font-mono); background: var(--color-surface-alt); padding: 0.15em 0.4em; border-radius: 4px; font-size: 0.88em; }
#resultado-contenido pre { background: #F2F6FA; border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 14px 16px; overflow-x: auto; margin: 0 0 1em; }
#resultado-contenido pre code { background: none; padding: 0; font-size: 0.87em; }

#resultado-contenido table { border-collapse: collapse; width: 100%; margin: 0 0 1em; font-size: 0.92rem; }
#resultado-contenido th, #resultado-contenido td { border: 1px solid var(--color-border); padding: 8px 10px; text-align: left; }
#resultado-contenido th { background: var(--color-surface-alt); }
#resultado-contenido hr { border: none; border-top: 1px solid var(--color-border); margin: 1.4em 0; }

.export-hint { display: block; margin-top: 10px; font-size: 0.85rem; color: var(--color-text-muted); text-align: right; }

footer.app-footer {
  display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px 16px;
  max-width: var(--max-width); margin: 0 auto;
  color: var(--color-text-faint); font-size: 0.8rem; padding: 24px 20px 8px;
}
footer.app-footer a { color: var(--color-text-muted); text-decoration: underline; }
footer.app-footer a:hover { color: var(--color-primary); }

.visually-hidden {
  position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
  overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
}
